# Copy this file to backend/.env and adjust values before starting the app.

ENV=production

# PostgreSQL connection string (created by deploy/install_ubuntu22.sh)
DATABASE_URL=postgresql+psycopg2://leadcrm_voip_lab:changeme@localhost:5432/leadcrm_voip_lab

# Generate a real secret, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed origins, or * for any (only use * for local testing)
CORS_ORIGINS=*

# Bootstrap Super Admin account - only used the very first time the app starts
# against an empty database. Change this password immediately after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Where the built frontend lives, so FastAPI can serve it directly.
# Leave unset (or point somewhere non-existent) if Nginx will serve the
# frontend directory itself instead - see deploy/nginx_leadcrm.conf.
FRONTEND_DIR=/opt/leadcrm-voip-lab/frontend
